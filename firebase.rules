rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL AUTH & ROLE FUNCTIONS (Custom Claims only – no Firestore lookups)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function tokenTenantId() {
      return request.auth.token.tenantId is string
        ? request.auth.token.tenantId
        : '';
    }

    function tokenRole() {
      return request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function isTenantMember(tenantId) {
      return isAuthenticated()
        && tokenTenantId() == tenantId;
    }

    function isAdmin(tenantId) {
      return isTenantMember(tenantId)
        && (
          request.auth.token.isAdmin == true
          || tokenRole() == 'admin'
        );
    }

    function isHelper(tenantId) {
      return isTenantMember(tenantId)
        && tokenRole() == 'helper';
    }

    function isEmployee(tenantId) {
      return isTenantMember(tenantId)
        && tokenRole() == 'employee';
    }

    function isEmployeeOrAdmin(tenantId) {
      return isTenantMember(tenantId)
        && !isHelper(tenantId)
        && (
          isAdmin(tenantId)
          || isEmployee(tenantId)
        );
    }

    function isTenantAdmin(tenantId) {
      return isAdmin(tenantId);
    }

    function hasModule(tenantId, moduleKey) {
      let tenantPath = /databases/$(database)/documents/tenants/$(tenantId);
      return exists(tenantPath)
        && get(tenantPath).data.keys().hasAny(['enabledModules'])
        && (
          get(tenantPath).data.enabledModules[moduleKey] == true
          || (moduleKey == 'wurstkueche' && get(tenantPath).data.enabledModules.kitchen == true)
        );
    }

    // Legacy alias – tenant access requires matching Custom Claim tenantId
    function isTenantUser(tenantId) {
      return isTenantMember(tenantId);
    }

    // =========================================================================
    // SCHEMA VALIDATION HELPERS
    // =========================================================================

    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }

    function isOptionalString(field) {
      return field == null || field is string;
    }

    function isNumericOrNull(field) {
      return field == null || field is int || field is float;
    }

    function isIntGteZero(field) {
      return (field is int || field is float) && field >= 0;
    }

    function isDateStringOrNull(field) {
      return field == null
        || (field is string && field.size() >= 8 && field.size() <= 24);
    }

    function hasOnly(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    // =========================================================================
    // USER PROFILES (read-only for the user, admin-managed)
    // =========================================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    match /userTenants/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // =========================================================================
    // TENANT ROOT (enabledModules – platform dev admin writes)
    // =========================================================================

    function isPlatformDevAdmin() {
      return isAuthenticated()
        && request.auth.uid in ['VYwMy5IAlAR26pj8ZbFfc5PNdou2'];
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isPlatformDevAdmin();
      allow create: if isPlatformDevAdmin()
        && request.resource.data.keys().hasOnly(['enabledModules', 'displayName', 'createdAt', 'updatedAt', 'status'])
        && request.resource.data.enabledModules is map
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.status in ['active', 'inactive'];
      allow update: if isPlatformDevAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['enabledModules'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && (!('status' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.status in ['active', 'inactive']);
      allow update: if isTenantAdmin(tenantId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['enabledModules'])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 120;
      allow delete: if isPlatformDevAdmin();
    }

    // =========================================================================
    // STAMMDATEN (admin-only writes)
    // =========================================================================

    match /tenants/{tenantId}/stammdaten/{document} {
      allow read: if isTenantUser(tenantId);
      allow write: if isAdmin(tenantId);
      allow update: if isEmployeeOrAdmin(tenantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentStock', 'updatedAt'
        ])
        && isIntGteZero(resource.data.currentStock)
        && isIntGteZero(request.resource.data.currentStock)
        && request.resource.data.currentStock <= resource.data.currentStock;
    }

    // Artikelname je EAN für künftige Wareneingänge (Protokoll-Korrektur + MHD-Bearbeiten)
    match /tenants/{tenantId}/product_master/{ean} {
      allow read: if isTenantUser(tenantId);
      allow create, update: if isEmployeeOrAdmin(tenantId)
        && request.resource.data.tenantId == tenantId
        && isNonEmptyString(request.resource.data.ean)
        && isNonEmptyString(request.resource.data.articleName)
        && request.resource.data.keys().hasOnly([
          'tenantId', 'ean', 'articleName', 'name', 'brand', 'category', 'kategorie',
          'updatedAt', 'updatedBy'
        ]);
      allow delete: if isAdmin(tenantId);
    }

    function isTeamDashboardSettings() {
      return request.resource.data.keys().hasOnly([
        'employees', 'groups', 'tenantId', 'updatedAt', 'updatedBy'
      ]);
    }

    function isProfileSettings(docId) {
      return docId == 'profile'
        && request.resource.data.keys().hasOnly([
          'betriebsName', 'appName', 'primaryColor', 'primaryColorHover', 'darkHeaderBg',
          'logoUrl', 'standardBereich', 'defaultTeam', 'terminalUser',
          'tenantId', 'updatedAt', 'updatedBy'
        ]);
    }

    function isTerminalSettings(docId) {
      return docId == 'terminal'
        && request.resource.data.keys().hasOnly([
          'isFixedTerminal', 'bypassPin', 'defaultOperatorName', 'terminalUser',
          'fixedTerminalEnabled', 'requirePin',
          'tenantId', 'updatedAt', 'updatedBy'
        ])
        && (!('isFixedTerminal' in request.resource.data) || request.resource.data.isFixedTerminal is bool)
        && (!('bypassPin' in request.resource.data) || request.resource.data.bypassPin is bool);
    }

    function isSupplierSettings(docId) {
      return docId == 'suppliers'
        && request.resource.data.keys().hasOnly([
          'names', 'suppliers', 'tenantId', 'updatedAt', 'updatedBy'
        ])
        && (!('names' in request.resource.data) || request.resource.data.names is list)
        && (!('suppliers' in request.resource.data) || request.resource.data.suppliers is list);
    }

    match /tenants/{tenantId}/settings/{document} {
      allow read: if isTenantUser(tenantId);
      allow create, update: if isAdmin(tenantId)
        && request.resource.data.tenantId == tenantId
        && (
          isTeamDashboardSettings()
          || isProfileSettings(document)
          || isTerminalSettings(document)
          || isSupplierSettings(document)
        );
      allow delete: if isAdmin(tenantId);
    }

    match /tenants/{tenantId}/employees/{employeeId} {
      allow read: if isAdmin(tenantId);
      allow create, update: if isAdmin(tenantId)
        && request.resource.data.tenantId == tenantId;
      allow delete: if isAdmin(tenantId);
    }

    match /tenants/{tenantId}/terminalCredentials/{document} {
      allow read, write: if false;
    }

    match /tenants/{tenantId}/pinAttempts/{document} {
      allow read, write: if false;
    }

    match /tenants/{tenantId}/pushTokens/{tokenId} {
      allow read: if false;
      allow create, update: if isEmployeeOrAdmin(tenantId)
        && request.resource.data.tenantId == tenantId
        && isNonEmptyString(request.resource.data.token)
        && isNonEmptyString(request.resource.data.employeeName);
      allow delete: if isEmployeeOrAdmin(tenantId);
    }

    // =========================================================================
    // MHD-POSTEN (mhd_liste) – Schema-validierte Schreibzugriffe
    // =========================================================================

    match /tenants/{tenantId}/mhd_liste/{document} {
      allow read: if isTenantUser(tenantId);

      allow create: if isEmployeeOrAdmin(tenantId)
        && hasOnly([
          'id', 'postenId', 'ean', 'barcode', 'scanBarcode',
          'produkt', 'name', 'marke', 'brand',
          'mhd', 'mhdDate', 'mhdText', 'mhdTimestamp', 'date',
          'tage', 'resttage', 'status',
          'qty', 'menge', 'eingangMenge', 'mengeEinheit', 'einheit',
          'kategorie', 'warenKategorie', 'soldOut',
          'lot', 'chargenNummer', 'lieferant', 'temperatur',
          'erfassungsDatum', 'meisterOverrideReason',
          'vpeBarcode', 'vpeInhalt',
          'source', 'postentyp', 'wareneingangAt',
          'tenantId', 'updatedAt', 'createdAt', 'scannedBy',
          'mhdActionStatus', 'lastMhdCheckDate', 'lastMhdCheckAt', 'lastCheckedDate', 'lastCheckedBy',
          'rabattiert', 'rabattiertAt',
          'kuecheAngefragt', 'kuecheAngefragtAt',
          'retterBoxAngefragt', 'retterBoxAngefragtAt',
          'lieferungId'
        ])
        && (
          isNonEmptyString(request.resource.data.name)
          || isNonEmptyString(request.resource.data.produkt)
        )
        && isIntGteZero(request.resource.data.qty)
        && request.resource.data.tenantId == tenantId;

      // Shopfloor-Updates: Mitarbeiter/Admins dürfen alle MHD-Felder ändern
      // (Quittierung, Menge, Status, Prüfdatum). tenantId darf nicht fremd gesetzt werden.
      allow update: if isEmployeeOrAdmin(tenantId)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tenantId'])
          || request.resource.data.tenantId == tenantId
        );

      allow delete: if isEmployeeOrAdmin(tenantId);
    }

    // Warenbewegungs-Report (MHD / Bestand) — Schreiben vom Laden-iPhone, Lesen im Büro
    match /tenants/{tenantId}/mhd_audit/{document} {
      allow read: if isTenantUser(tenantId) || isPlatformDevAdmin();
      allow create: if isEmployeeOrAdmin(tenantId)
        && request.resource.data.tenantId == tenantId
        && isNonEmptyString(request.resource.data.actionType)
        && isNonEmptyString(request.resource.data.articleName);
      allow update, delete: if isAdmin(tenantId) || isPlatformDevAdmin();
    }

    match /tenants/{tenantId}/audit_logs/{document} {
      allow read: if isTenantUser(tenantId) || isPlatformDevAdmin();
      allow create: if isEmployeeOrAdmin(tenantId)
        && request.resource.data.tenantId == tenantId
        && isNonEmptyString(request.resource.data.actionType)
        && isNonEmptyString(request.resource.data.articleName);
      allow update, delete: if isAdmin(tenantId) || isPlatformDevAdmin();
    }

    // =========================================================================
    // WARENEINGANG-LIEFERUNGEN (Kopf + Posten + Lieferschein-Fotos)
    // =========================================================================

    match /tenants/{tenantId}/inventory/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && (request.auth.token.role in ['admin', 'employee']);
    }

    // =========================================================================
    // RETTER-BOXEN (abschaltbares Hofladen-Angebot aus MHD-Posten)
    // =========================================================================

    match /tenants/{tenantId}/retter_boxen/{document} {
      allow read: if isTenantUser(tenantId)
        && hasModule(tenantId, 'retterBox');

      allow create, update: if isEmployeeOrAdmin(tenantId)
        && hasModule(tenantId, 'retterBox')
        && hasOnly([
          'id', 'title', 'date', 'status',
          'items', 'itemCount',
          'recipeTitle', 'recipeSteps', 'customerText', 'priceHint',
          'tenantId', 'createdAt', 'updatedAt',
          'printedAt', 'soldAt', 'discardedAt'
        ])
        && isNonEmptyString(request.resource.data.title)
        && isNonEmptyString(request.resource.data.date)
        && isNonEmptyString(request.resource.data.status)
        && request.resource.data.tenantId == tenantId
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 30
        && isIntGteZero(request.resource.data.itemCount);

      allow delete: if isAdmin(tenantId)
        && hasModule(tenantId, 'retterBox');
    }

    match /tenants/{tenantId}/delivery_note_drafts/{draftId} {
      allow read, create, update, delete: if request.auth != null && request.auth.token.tenantId == tenantId;
    }

    match /tenants/{tenantId}/wareneingang_lieferungen/{document} {
      allow read: if isTenantUser(tenantId);

      allow create, update: if isEmployeeOrAdmin(tenantId)
        && hasOnly([
          'id', 'lieferant', 'warenKategorie', 'temperatur',
          'erfassungsDatum', 'completedAt', 'status', 'meisterOverrideReason',
          'fotos', 'items', 'itemCount',
          'source', 'scannedBy', 'tenantId',
          'createdAt', 'updatedAt'
        ])
        && isNonEmptyString(request.resource.data.lieferant)
        && request.resource.data.tenantId == tenantId
        && isIntGteZero(request.resource.data.itemCount);

      allow delete: if isEmployeeOrAdmin(tenantId);
    }

    // =========================================================================
    // REZEPTE (admin-only writes)
    // =========================================================================

    match /tenants/{tenantId}/rezepte/{document} {
      allow read: if isTenantUser(tenantId)
        && hasModule(tenantId, 'wurstkueche');
      allow write: if isAdmin(tenantId)
        && hasModule(tenantId, 'wurstkueche');
    }

    // =========================================================================
    // FLEISCHPREISE (KI-Wochennotierung, nur Cloud Functions schreiben)
    // =========================================================================

    match /tenants/{tenantId}/fleischpreise/{document} {
      allow read: if isTenantUser(tenantId);
      allow write: if false;
    }

    // =========================================================================
    // PRODUKTIONS-CHARGEN
    // =========================================================================

    match /tenants/{tenantId}/produktion_chargen/{document} {
      allow read, create: if isEmployeeOrAdmin(tenantId)
        && hasModule(tenantId, 'wurstkueche');
      allow update, delete: if isAdmin(tenantId)
        && hasModule(tenantId, 'wurstkueche');
    }

    // Galloway-Zerlegung: Ausbeute-Protokoll im Chargenbuch
    match /tenants/{tenantId}/zerlegung_ausbeute/{docId} {
      allow read, write: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && request.auth.token.role == 'admin';
    }

    // =========================================================================
    // HACCP-GERÄTE – Ausschließlich Admin-Zugriff für Schreiboperationen
    // =========================================================================

    match /tenants/{tenantId}/haccp_geraete/{document} {
      allow read: if isTenantUser(tenantId);

      allow create, update: if isAdmin(tenantId)
        && hasOnly([
          'name', 'protokollTyp', 'bereich', 'geraeteTyp',
          'sollMin', 'sollMax', 'einheit', 'intervall',
          'aktiv', 'tenantId', 'updatedAt', 'createdAt'
        ])
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.tenantId == tenantId;

      allow delete: if isAdmin(tenantId);
    }

    // =========================================================================
    // HACCP-LOGS – Validierte Protokolleinträge (unveränderlich nach Anlage)
    // =========================================================================

    match /tenants/{tenantId}/haccp_logs/{document} {
      allow read: if isTenantUser(tenantId);

      allow create: if isEmployeeOrAdmin(tenantId)
        && hasOnly([
          'logTyp', 'deviceId', 'deviceName', 'bereich',
          'wert', 'temperatur', 'ph',
          'einheit', 'sollMin', 'sollMax',
          'status', 'massnahme',
          'chargenNummer',
          'tenantId', 'datum', 'createdAt'
        ])
        && isNonEmptyString(request.resource.data.logTyp)
        && isNonEmptyString(request.resource.data.datum)
        && request.resource.data.tenantId == tenantId
        && isNumericOrNull(request.resource.data.wert)
        && isNumericOrNull(request.resource.data.temperatur)
        && isNumericOrNull(request.resource.data.ph)
        && (
          request.resource.data.createdAt == request.time
          || (
            request.resource.data.createdAt is timestamp
            && request.resource.data.createdAt > request.time - duration.value(48, 'h')
          )
          || (
            request.resource.data.createdAt is string
            && request.resource.data.createdAt.size() >= 20
          )
        );

      allow update, delete: if false;
    }

    // =========================================================================
    // HACCP STALE ARCHIVE – Cold-Storage für veraltete, abgewiesene Protokolle
    // =========================================================================

    match /tenants/{tenantId}/haccp_stale_archive/{document} {
      allow read: if isTenantUser(tenantId);

      allow create: if isEmployeeOrAdmin(tenantId)
        && request.resource.data.tenantId == tenantId
        && isNonEmptyString(request.resource.data._reason);

      allow update, delete: if isAdmin(tenantId);
    }

    // =========================================================================
    // SCHWARZES BRETT (bulletinBoard/current)
    // =========================================================================

    match /tenants/{tenantId}/bulletinBoard/{document} {
      allow read: if isTenantUser(tenantId);

      allow create, update: if isAdmin(tenantId)
        && hasOnly([
          'message', 'attachments', 'updatedAt', 'author', 'tenantId'
        ])
        && isOptionalString(request.resource.data.message)
        && request.resource.data.tenantId == tenantId;

      allow delete: if isAdmin(tenantId);
    }

    match /tenants/{tenantId}/bulletinConfirmations/{confirmationId} {
      allow read: if isTenantUser(tenantId);

      allow create: if isEmployeeOrAdmin(tenantId)
        && request.resource.data.tenantId == tenantId
        && hasOnly([
          'employeeName', 'confirmedAt', 'bulletinMessage', 'bulletinUpdatedAt',
          'tenantId', 'deviceId', 'profileEmail'
        ])
        && isNonEmptyString(request.resource.data.employeeName)
        && isNonEmptyString(request.resource.data.confirmedAt);

      allow update, delete: if isAdmin(tenantId);
    }

    // =========================================================================
    // AUFGABEN-TOKENS (tasks)
    // =========================================================================

    function isTaskCompletionOnly() {
      return resource.data.status == 'open'
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedBy', 'completedAt'
        ])
        && isNonEmptyString(request.resource.data.completedBy);
    }

    function existingTaskCommentCount() {
      return ('comments' in resource.data) && resource.data.comments is list
        ? resource.data.comments.size()
        : 0;
    }

    function newTaskComment() {
      return request.resource.data.comments[request.resource.data.comments.size() - 1];
    }

    function isTaskCommentShape(comment) {
      return comment is map
        && comment.keys().hasAll(['author', 'text', 'createdAt'])
        && comment.keys().hasOnly(['author', 'text', 'createdAt'])
        && isNonEmptyString(comment.author)
        && isNonEmptyString(comment.text)
        && comment.text.size() <= 500
        && isNonEmptyString(comment.createdAt);
    }

    function isTaskCommentOnly(tenantId) {
      return isTenantUser(tenantId)
        && resource.data.tenantId == tenantId
        && request.resource.data.tenantId == tenantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        && request.resource.data.comments is list
        && request.resource.data.comments.size() == existingTaskCommentCount() + 1
        && isTaskCommentShape(newTaskComment());
    }

    match /tenants/{tenantId}/tasks/{taskId} {
      allow read: if isTenantUser(tenantId);

      allow create: if isEmployeeOrAdmin(tenantId)
        && request.resource.data.tenantId == tenantId
        && isNonEmptyString(request.resource.data.title)
        && isNonEmptyString(request.resource.data.author)
        && request.resource.data.status == 'open'
        && (
          !('audienceMembers' in request.resource.data)
          || request.resource.data.audienceMembers is list
        );

      allow update: if isEmployeeOrAdmin(tenantId)
        && (
          isAdmin(tenantId)
          || isTaskCompletionOnly()
        )
        || isTaskCommentOnly(tenantId);

      allow delete: if isAdmin(tenantId);
    }

    // =========================================================================
    // CHARGEN-DOKU / Thekenbuch – LMIV Fleisch-Herkunft
    // Primär: tenants/{tenantId}/chargendoku/{id}
    // Legacy: tenants/{tenantId}/traceabilityRecords/{id}
    // =========================================================================

    function isValidTraceabilityAnimalType(value) {
      return value in ['rind', 'schwein', 'gefluegel', 'schaf', 'ziege'];
    }

    function isValidTraceabilityStatus(value) {
      return value in ['active', 'archived'];
    }

    function isValidTraceabilityOrigin(origin, animalType) {
      return origin is map
        && origin.keys().hasAll([
          'isSingleOrigin', 'singleOriginCountry',
          'bornIn', 'raisedIn', 'slaughteredIn', 'cutIn', 'cuttingPlantNo'
        ])
        && origin.isSingleOrigin is bool
        && origin.singleOriginCountry is string
        && origin.bornIn is string
        && origin.raisedIn is string
        && origin.slaughteredIn is string
        && origin.cutIn is string
        && origin.cuttingPlantNo is string
        && (
          (
            origin.isSingleOrigin == true
            && isNonEmptyString(origin.singleOriginCountry)
          )
          || (
            origin.isSingleOrigin == false
            && isNonEmptyString(origin.raisedIn)
            && isNonEmptyString(origin.slaughteredIn)
            && (
              animalType != 'rind'
              || (
                isNonEmptyString(origin.bornIn)
                && isNonEmptyString(origin.cutIn)
                && isNonEmptyString(origin.cuttingPlantNo)
              )
            )
          )
        );
    }

    function isValidTraceabilityRecord(tenantId) {
      return hasOnly([
          'id', 'createdAt', 'createdBy', 'status',
          'lotNumber', 'healthMark', 'imageUrl',
          'animalType', 'origin', 'tenantId',
          'organicControlBody', 'organicAssociation'
        ])
        && isNonEmptyString(request.resource.data.id)
        && isNonEmptyString(request.resource.data.createdBy)
        && isValidTraceabilityStatus(request.resource.data.status)
        && isNonEmptyString(request.resource.data.lotNumber)
        && request.resource.data.healthMark is string
        && isNonEmptyString(request.resource.data.imageUrl)
        && isValidTraceabilityAnimalType(request.resource.data.animalType)
        && isValidTraceabilityOrigin(
          request.resource.data.origin,
          request.resource.data.animalType
        )
        && request.resource.data.tenantId == tenantId
        && (
          !('organicControlBody' in request.resource.data)
          || request.resource.data.organicControlBody is string
        )
        && (
          !('organicAssociation' in request.resource.data)
          || request.resource.data.organicAssociation is string
        )
        && (
          request.resource.data.createdAt == request.time
          || (
            request.resource.data.createdAt is timestamp
            && request.resource.data.createdAt > request.time - duration.value(48, 'h')
          )
          || (
            request.resource.data.createdAt is string
            && request.resource.data.createdAt.size() >= 20
          )
        );
    }

    function isTraceabilityStatusOnlyUpdate(tenantId) {
      return resource.data.tenantId == tenantId
        && request.resource.data.tenantId == tenantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && isValidTraceabilityStatus(request.resource.data.status);
    }

    // Chargen-Doku / Thekenbuch (neu)
    match /tenants/{tenantId}/chargendoku/{document} {
      allow read: if isTenantUser(tenantId);

      // Erfassung für alle Mandanten-Rollen (inkl. helper / Aushilfe)
      allow create: if isTenantUser(tenantId)
        && isValidTraceabilityRecord(tenantId);

      allow update: if isAdmin(tenantId)
        && isTraceabilityStatusOnlyUpdate(tenantId);

      allow delete: if isAdmin(tenantId);
    }

    // Legacy LMIV-Collection – Lesen + Status-Update für Migration
    match /tenants/{tenantId}/traceabilityRecords/{document} {
      allow read: if isTenantUser(tenantId);

      allow create: if isTenantUser(tenantId)
        && isValidTraceabilityRecord(tenantId);

      allow update: if isAdmin(tenantId)
        && isTraceabilityStatusOnlyUpdate(tenantId);

      allow delete: if isAdmin(tenantId);
    }

    // =========================================================================
    // KUNDENBESTELLUNGEN (customerOrders)
    // =========================================================================

    function hasCustomerContact() {
      return (request.resource.data.callbackPhone is string
          && request.resource.data.callbackPhone.size() > 0)
        || (request.resource.data.customerEmail is string
          && request.resource.data.customerEmail.size() > 3);
    }

    function isCustomerOrderItemsList(items) {
      return items is list && items.size() >= 1 && items.size() <= 40;
    }

    function isCustomerOrderStatusUpdate() {
      return resource.data.tenantId == request.auth.token.tenantId
        && request.resource.data.tenantId == request.auth.token.tenantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'readyMarkedBy', 'readyMarkedAt', 'pickedUpBy', 'pickedUpAt'
        ])
        && isNonEmptyString(request.resource.data.status)
        && (
          (resource.data.status == 'open' && request.resource.data.status == 'ready')
          || (resource.data.status == 'ready' && request.resource.data.status == 'picked_up')
          || (resource.data.status == 'open' && request.resource.data.status == 'cancelled')
        );
    }

    match /tenants/{tenantId}/customerOrders/{orderId} {
      allow read: if isTenantUser(tenantId);

      allow create: if isEmployeeOrAdmin(tenantId)
        && hasOnly([
          'customerName', 'callbackPhone', 'customerEmail', 'readyAt',
          'items', 'additionalWishes', 'orderSlipAttachments', 'inputMode',
          'acceptedBy', 'acceptedAt', 'status', 'tenantId', 'createdAt'
        ])
        && isNonEmptyString(request.resource.data.acceptedBy)
        && isNonEmptyString(request.resource.data.readyAt)
        && request.resource.data.status == 'open'
        && request.resource.data.tenantId == tenantId
        && isOptionalString(request.resource.data.customerName)
        && isOptionalString(request.resource.data.additionalWishes)
        && isOptionalString(request.resource.data.callbackPhone)
        && isOptionalString(request.resource.data.customerEmail)
        && isOptionalString(request.resource.data.inputMode)
        && (
          isCustomerOrderItemsList(request.resource.data.items)
          || (
            request.resource.data.orderSlipAttachments is list
            && request.resource.data.orderSlipAttachments.size() > 0
          )
        )
        && (
          !('customerName' in request.resource.data)
          || isNonEmptyString(request.resource.data.customerName)
          || (
            request.resource.data.orderSlipAttachments is list
            && request.resource.data.orderSlipAttachments.size() > 0
          )
        )
        && (
          hasCustomerContact()
          || (
            request.resource.data.orderSlipAttachments is list
            && request.resource.data.orderSlipAttachments.size() > 0
          )
        );

      allow update: if isEmployeeOrAdmin(tenantId)
        && (
          isAdmin(tenantId)
          || isCustomerOrderStatusUpdate()
        );

      allow delete: if isAdmin(tenantId);
    }

    // =========================================================================
    // SYSTEM ERRORS – mandantenisoliert, append-only, ohne Personenklartext
    // =========================================================================

    match /system_errors/{document} {
      allow read, write: if false;
    }

    match /tenants/{tenantId}/system_errors/{errorId} {
      allow create: if request.auth != null
        && request.auth.token.tenantId == tenantId
        && request.resource.data.tenantId == tenantId
        && request.resource.data.keys().hasAll(['tenantId', 'errorCode', 'message', 'timestamp'])
        && request.resource.data.keys().hasOnly(['tenantId', 'errorCode', 'message', 'timestamp', 'context'])
        && request.resource.data.errorCode is string
        && request.resource.data.message is string
        && request.resource.data.message.size() < 1000
        && request.resource.data.timestamp == request.time;

      allow read: if isTenantAdmin(tenantId);
      allow update, delete: if false;
    }

    // =========================================================================
    // PRICE RUNS – Lifecycle-Logging (nur Cloud Functions / Admin SDK)
    // =========================================================================

    match /priceRuns/{runId} {
      allow read, write: if false;
    }
  }
}
