rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasTenantClaim(tenantId) {
      return isAuthenticated()
        && request.auth.token.tenantId is string
        && request.auth.token.tenantId == tenantId;
    }

    function profilePath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function hasTenantProfile(tenantId) {
      return isAuthenticated()
        && firestore.exists(profilePath())
        && firestore.get(profilePath()).data.tenantId is string
        && firestore.get(profilePath()).data.tenantId == tenantId;
    }

    function isTenantUser(tenantId) {
      return hasTenantClaim(tenantId) || hasTenantProfile(tenantId);
    }

    function isAdmin(tenantId) {
      return isTenantUser(tenantId)
        && (
          request.auth.token.role == 'admin'
          || request.auth.token.admin == true
          || (
            firestore.exists(profilePath())
            && firestore.get(profilePath()).data.role == 'admin'
          )
        );
    }

    match /tenants/{tenantId}/bulletin/{fileName} {
      allow read: if isTenantUser(tenantId);
      allow write: if isAdmin(tenantId)
        && request.resource.size < 12 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }
  }
}
