rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Custom Claims only – mirrors firebase.rules (no firestore.get)

    function istAngemeldet() {
      return request.auth != null;
    }

    function tokenTenantId() {
      return request.auth.token.tenantId is string
        ? request.auth.token.tenantId
        : '';
    }

    function tokenRole() {
      return request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function istTenantMitglied(tenantId) {
      return istAngemeldet() && tokenTenantId() == tenantId;
    }

    function istAdmin(tenantId) {
      return istTenantMitglied(tenantId)
        && (
          request.auth.token.isAdmin == true
          || tokenRole() == 'admin'
        );
    }

    function istHelper() {
      return tokenRole() == 'helper';
    }

    function istMitarbeiter(tenantId) {
      return istTenantMitglied(tenantId)
        && !istHelper()
        && (
          tokenRole() == 'employee'
          || istAdmin(tenantId)
        );
    }

    function istBildOderPdf() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf';
    }

    function istDateigroesseOk() {
      return request.resource.size < 12 * 1024 * 1024;
    }

    // App-Pfad: tenants/{tenantId}/bulletin/… (Singular, siehe teamboard.js)
    match /tenants/{tenantId}/bulletin/{allPaths=**} {
      allow read: if istTenantMitglied(tenantId);
      allow write: if istAdmin(tenantId) && istDateigroesseOk() && istBildOderPdf();
    }

    match /tenants/{tenantId}/order_slips/{allPaths=**} {
      allow read: if istTenantMitglied(tenantId);
      allow write: if istMitarbeiter(tenantId) && istDateigroesseOk() && istBildOderPdf();
    }

    // LMIV-Etikettfotos: tenants/{tenantId}/traceability/{recordId}.jpg
    match /tenants/{tenantId}/traceability/{allPaths=**} {
      allow read: if istTenantMitglied(tenantId);
      allow write: if istTenantMitglied(tenantId) && istDateigroesseOk() && istBildOderPdf();
    }
  }
}
