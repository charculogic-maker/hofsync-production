rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Custom Claims only – mirrors firebase.rules (no firestore.get)

    function istAngemeldet() {
      return request.auth != null;
    }

    function tokenTenantId() {
      return request.auth.token.tenantId is string
        ? request.auth.token.tenantId
        : '';
    }

    function tokenRole() {
      return request.auth.token.role is string
        ? request.auth.token.role
        : '';
    }

    function tokenIsAdmin() {
      return ('isAdmin' in request.auth.token)
        && request.auth.token.isAdmin == true;
    }

    function istTenantMitglied(tenantId) {
      return istAngemeldet() && tokenTenantId() == tenantId;
    }

    function istAktiverTenant(tenantId) {
      return firestore.exists(/databases/(default)/documents/tenants/$(tenantId))
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.status != 'inactive';
    }

    function istAktivesTenantMitglied(tenantId) {
      return istTenantMitglied(tenantId) && istAktiverTenant(tenantId);
    }

    function istAdmin(tenantId) {
      return istAktivesTenantMitglied(tenantId)
        && (
          tokenIsAdmin()
          || tokenRole() == 'admin'
        );
    }

    function istHelper() {
      return tokenRole() == 'helper';
    }

    function istMitarbeiter(tenantId) {
      return istAktivesTenantMitglied(tenantId)
        && !istHelper()
        && (
          tokenRole() == 'employee'
          || tokenIsAdmin()
          || tokenRole() == 'admin'
        );
    }

    function istBildOderPdf() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf';
    }

    function istDateigroesseOk() {
      return request.resource.size < 12 * 1024 * 1024;
    }

    // App-Pfad: tenants/{tenantId}/bulletin/… (Singular, siehe teamboard.js)
    match /tenants/{tenantId}/bulletin/{allPaths=**} {
      allow read: if istAktivesTenantMitglied(tenantId);
      allow write: if istAdmin(tenantId) && istDateigroesseOk() && istBildOderPdf();
    }

    match /tenants/{tenantId}/order_slips/{allPaths=**} {
      allow read: if istAktivesTenantMitglied(tenantId);
      allow write: if istMitarbeiter(tenantId) && istDateigroesseOk() && istBildOderPdf();
    }

    // Chargen-Doku Etikettfotos: tenants/{tenantId}/chargendoku/{recordId}.jpg
    match /tenants/{tenantId}/chargendoku/{allPaths=**} {
      allow read: if istAktivesTenantMitglied(tenantId);
      allow write: if istAktivesTenantMitglied(tenantId) && istDateigroesseOk() && istBildOderPdf();
    }

    // Legacy LMIV-Fotos (Migration)
    match /tenants/{tenantId}/traceability/{allPaths=**} {
      allow read: if istAktivesTenantMitglied(tenantId);
      allow write: if istAktivesTenantMitglied(tenantId) && istDateigroesseOk() && istBildOderPdf();
    }
  }
}
