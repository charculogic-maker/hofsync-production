rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- HILFSFUNKTIONEN ---
    function istAngemeldet() {
      return request.auth != null;
    }
    
    function istAdmin() {
      return istAngemeldet() && request.auth.token.isAdmin == true;
    }

    // --- BULLETIN UPLOADS ---
    match /tenants/{tenantId}/bulletin/{allPaths=**} {
      allow read: if istAngemeldet();
      allow write: if istAdmin()
                   && request.resource.size < 12 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    match /tenants/{tenantId}/order_slips/{allPaths=**} {
      allow read: if istAngemeldet();
      allow write: if istAngemeldet()
                   && request.resource.size < 12 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
