# Firebase parameterized config (copied by CLI during deploy).
# Real credentials belong in .env.local / .env.*.local (gitignored) or Secret Manager.
# "unset" = integration disabled — required so deploys stay non-interactive.

SMTP_HOST=mail.agenturserver.de
SMTP_PORT=465
SMTP_USER=bestellung@steveshof-hofladen.de
SMTP_PASS=unset
FROM_EMAIL=bestellung@steveshof-hofladen.de
TWILIO_ACCOUNT_SID=unset
TWILIO_AUTH_TOKEN=unset
FROM_NUMBER=unset
